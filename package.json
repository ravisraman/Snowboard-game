{
  "name": "alpine-carve",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A downhill snowboarding game built with Three.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "check": "node tools/check-mechanics.mjs",
    "check:offline": "vite build && node tools/check-offline.mjs",
    "bundle": "vite build && node tools/build-singlefile.mjs"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "playwright": "^1.62.0",
    "vite": "^8.1.5"
  }
}
